{
  // The extension: same strictness as the core, plus Chrome's API types. allowJs lets it
  // import the site's own chart/format code (web/*.js) instead of copying it.
  "extends": "./tsconfig.json",
  "compilerOptions": { "allowJs": true, "checkJs": false, "types": ["chrome"] },
  "include": ["extension/src/**/*.ts", "android/js/**/*.ts"]
}
