{
  "manifest_version": 3,
  "name": "Britto: price history and real discounts",
  "short_name": "Britto",
  "version": "0.3.0",
  "description": "See a product's price history and whether its discount is real, on Amazon.in, Flipkart, Myntra and Vijay Sales product pages.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.myntra.com/*", "https://www.vijaysales.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://britto.amitynoidalibrary.workers.dev/*"]
}
