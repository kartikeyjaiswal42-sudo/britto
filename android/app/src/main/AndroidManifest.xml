<?xml version="1.0" encoding="utf-8"?>
<!-- Britto for Android (BLUEPRINT §18): the website in a WebView, plus Super Browse, an
     in-app browser per store that reads the page the shopper is looking at with the same
     reader the extension uses. Version, SDK levels and the site address: app/build.gradle.kts.
     Permissions: the internet; showing notifications (price alerts, asked for when the shopper
     sets one); knowing whether there is a network (Android 14 refuses a job that waits for one
     without it: measured, the app crashed); and starting the alert check again after a restart. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Britto"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!-- The Britto website, and the share target: "Share -> Britto" from a store's app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Price alerts as notifications: a periodic check of this phone's alerts (AlertJob). -->
        <service
            android:name=".AlertJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Super Browse: one store in an in-app browser, with the Britto panel. -->
        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>
</manifest>
