<?xml version="1.0" encoding="utf-8"?>
<!-- The design's mark (web/favicon.svg): a white "b" on Britto blue. Android 8+ shapes it
     itself (circle, squircle); the PNG in mipmap-xxxhdpi is for launchers that do not. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/britto_blue" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
