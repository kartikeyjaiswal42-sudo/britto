<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to a Worker on the computer running the emulator
     (10.0.2.2 is the host from inside the Android emulator), for -Pbritto.site=http://10.0.2.2:<port>.
     Every other address stays HTTPS-only, as in the release build. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
